def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="tiktok-ads-mcp",
        description=(
            "CLI gọi TikTok Ads official MCP (OAuth) — dùng qua terminal để "
            "không phải nạp MCP vào agent mỗi phiên."
        ),
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_login = sub.add_parser("login", help="Đăng nhập OAuth qua browser (chạy 1 lần)")
    p_login.add_argument("--no-browser", action="store_true", help="Không tự mở browser, chỉ in URL")
    p_login.add_argument("--print-url", action="store_true", help="Chỉ in authorize URL rồi thoát (debug)")
    p_login.add_argument("--timeout", type=int, default=LOGIN_TIMEOUT, help="Giây chờ callback (mặc định 300)")
    p_login.set_defaults(func=cmd_login)

    sub.add_parser("status", help="Xem trạng thái token local").set_defaults(func=cmd_status)
    sub.add_parser("logout", help="Xoá token local + revoke").set_defaults(func=cmd_logout)

    p_whoami = sub.add_parser("whoami", help="Gọi user_info_get")
    p_whoami.add_argument("--raw", action="store_true", help="In nguyên response MCP")
    p_whoami.set_defaults(func=cmd_whoami)

    p_adv = sub.add_parser("advertisers", help="Gọi auth_advertiser_get")
    p_adv.add_argument("--raw", action="store_true", help="In nguyên response MCP")
    p_adv.set_defaults(func=cmd_advertisers)

    p_tools = sub.add_parser("tools", help="Liệt kê tools của official MCP")
    p_tools.add_argument("--json", action="store_true", help="In full schema")
    p_tools.set_defaults(func=cmd_tools)

    p_call = sub.add_parser("call", help="Gọi tool bất kỳ của MCP")
    p_call.add_argument("tool", help="Tên tool, ví dụ: auth_advertiser_get")
    p_call.add_argument("--params", help="Tham số dạng JSON, ví dụ: '{\"advertiser_id\":\"7...\"}'")
    p_call.add_argument("--params-file", help="Đọc tham số JSON từ file")
    p_call.add_argument("-p", "--param", action="append", help="Tham số key=value (lặp lại được)")
    p_call.add_argument("--raw", action="store_true", help="In nguyên response MCP")
    p_call.set_defaults(func=cmd_call)

    return parser


def main(argv=None) -> int:
    try:  # để output hiện ngay cả khi bị pipe/redirect qua file (agent gọi hộ)
        sys.stdout.reconfigure(line_buffering=True)
        sys.stderr.reconfigure(line_buffering=True)
    except Exception:
        pass
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nĐã huỷ.", file=sys.stderr)
        sys.exit(130)
